{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build && cp static/app-ui/index.html static/index.html",
  "outputDirectory": "static",
  "functions": {
    "api/lark/migration.py": {
      "maxDuration": 300
    },
    "api/reports.py": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/payroll",
      "destination": "/api/reports?action=payroll"
    },
    {
      "source": "/api/database/setup",
      "destination": "/api/reports?action=database_setup"
    },
    {
      "source": "/api/payroll/access",
      "destination": "/api/reports?action=payroll_access"
    },
    {
      "source": "/api/payroll/unlock",
      "destination": "/api/reports?action=payroll_unlock"
    },
    {
      "source": "/api/ai/parse",
      "destination": "/api/reports?action=ai_parse"
    },
    {
      "source": "/api/ai/apply",
      "destination": "/api/reports?action=ai_apply"
    },
    {
      "source": "/api/payroll_worker_detail",
      "destination": "/api/reports?action=payroll_worker_detail"
    },
    {
      "source": "/api/payroll_check",
      "destination": "/api/reports?action=payroll_check"
    },
    {
      "source": "/api/location_detail",
      "destination": "/api/reports?action=location_detail"
    },
    {
      "source": "/api/day",
      "destination": "/api/reports?action=day"
    },
    {
      "source": "/api/day/clear",
      "destination": "/api/reports?action=day_clear"
    },
    {
      "source": "/api/worker-month",
      "destination": "/api/reports?action=worker_month"
    },
    {
      "source": "/api/worker-days",
      "destination": "/api/reports?action=worker_days"
    },
    {
      "source": "/api/worker-days/copy",
      "destination": "/api/reports?action=worker_days_copy"
    },
    {
      "source": "/api/workers",
      "destination": "/api/reports?action=workers"
    },
    {
      "source": "/api/workers/access",
      "destination": "/api/reports?action=workers_access"
    },
    {
      "source": "/api/workers/unlock",
      "destination": "/api/reports?action=workers_unlock"
    },
    {
      "source": "/",
      "destination": "/app-ui/index.html"
    }
  ]
}
