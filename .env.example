# Public production origin; no trailing slash.
APP_URL=https://your-project.vercel.app

# Operational data storage. PostgreSQL can be AWS RDS, Neon, or another
# TLS-enabled managed PostgreSQL service.
DATA_BACKEND=lark
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# After the PostgreSQL sync schema is initialized, enable asynchronous
# AWS/Neon -> Lark Base mirroring. PostgreSQL remains the source of truth.
LARK_MIRROR_ENABLED=false

# Lark custom-app credentials. Configure real values only in Vercel.
LARK_APP_ID=cli_replace_me
LARK_APP_SECRET=replace_in_vercel
LARK_OAUTH_SCOPES=offline_access
# Comma-separated Lark open_id values allowed to initialize and administer data.
LARK_ADMIN_OPEN_IDS=ou_replace_me
# Optional second-factor password for users who are not in the Lark admin list.
WORKER_ADMIN_PASSWORD=replace_with_a_long_unique_password
PAYROLL_PASSWORD=replace_with_a_different_long_unique_password

# From Developer Console > Events & Callbacks > Event Configuration.
# Leave Lark's Encrypt Key empty for the initial webhook setup.
LARK_VERIFICATION_TOKEN=replace_in_vercel

# Lark Base identifiers. The app token is visible in the Base URL.
LARK_BASE_APP_TOKEN=app_replace_me
LARK_WORKERS_TABLE_ID=tbl_replace_me
LARK_WORK_DAYS_TABLE_ID=tbl_replace_me
LARK_LOCATION_ENTRIES_TABLE_ID=tbl_replace_me
LARK_COST_CENTERS_TABLE_ID=tbl_replace_me
LARK_PAYROLL_CHECKS_TABLE_ID=tbl_replace_me
LARK_AUDIT_LOG_TABLE_ID=tbl_replace_me

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_at_least_32_random_characters

# Server-side only. Rotate any key previously pasted into chat.
GEMINI_API_KEY=replace_in_vercel
