# Public production origin; no trailing slash.
APP_URL=https://your-project.vercel.app
APP_TIME_ZONE=America/Los_Angeles

# Production currently uses AWS RDS for PostgreSQL. The adapter can also use
# Neon or another TLS-enabled managed PostgreSQL service.
DATA_BACKEND=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# After the PostgreSQL sync schema is initialized, enable asynchronous
# PostgreSQL -> consolidated Lark Work Log/reference-table mirroring.
# PostgreSQL remains the source of truth.
LARK_MIRROR_ENABLED=false

# Lark custom-app credentials. Configure real values only in Vercel.
LARK_APP_ID=cli_replace_me
LARK_APP_SECRET=replace_in_vercel
LARK_OAUTH_SCOPES=offline_access
# Comma-separated Lark open_id values allowed to initialize and administer data.
LARK_ADMIN_OPEN_IDS=ou_replace_me
# Optional alternate protected-page passwords for signed-in users.
WORKER_ADMIN_PASSWORD=replace_with_a_long_unique_password
# Shared by Payroll Check and Location Check.
PAYROLL_PASSWORD=replace_with_a_different_long_unique_password
EXPORT_PASSWORD=replace_with_a_third_long_unique_password

# From Developer Console > Events & Callbacks > Event Configuration.
# Leave Lark's Encrypt Key empty for the initial webhook setup.
LARK_VERIFICATION_TOKEN=replace_in_vercel

# Lark Base identifier. The app token is visible in the Base URL. Current code
# discovers table IDs by their exact table names.
LARK_BASE_APP_TOKEN=app_replace_me

# Required to create the connected Drive spreadsheet.
LARK_DRIVE_FOLDER_TOKEN=fld_replace_me
# Separate Cost Code source. It does not need to be in the folder above.
# Share it with the Lark app's access group, then paste its /wiki/, /sheets/, or /file/ URL.
LARK_COST_CODE_SOURCE_URL=https://your-tenant.larksuite.com/wiki/wik_replace_me
# Vercel sends this value as `Authorization: Bearer ...` to daily Cron requests.
CRON_SECRET=replace_with_a_random_string_at_least_32_characters
# Optional for a manually created spreadsheet. When blank, the administrator
# workbook endpoint creates one and stores its token in PostgreSQL.
LARK_WORKBOOK_TOKEN=

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_at_least_32_random_characters

# Server-side only. Rotate any key previously pasted into chat.
GEMINI_API_KEY=replace_in_vercel
# Stable multimodal model used by AI Reading.
GEMINI_MODEL=gemini-3.6-flash
